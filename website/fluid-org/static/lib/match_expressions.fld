def lookup[V](k: float, Empty(): Tree[tuple[float, V]]) -> V | None:
  return None
def lookup[V](k: float, NonEmpty(left, (key, val), right): Tree[tuple[float, V]]) -> V | None:
  match compare(k, key):
    case LT():
      return lookup(k, left)
    case EQ():
      return val
    case GT():
      return lookup(k, right)
