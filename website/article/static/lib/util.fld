from typing import Callable
from dataset.scigen._1805_02474v1_10 import Model

def insert[A](lt: Callable[[A, A], bool], x: A, ys: list[A]) -> list[A]:
  def go(i: int) -> list[A]:
    if i == len(ys) or x |lt| ys[i]:
      return take(i, ys) + [x] + drop(i, ys)
    return go(i + 1)
  return go(0)

def insertionSort[A](lt: Callable[[A, A], bool], lst: list[A]) -> list[A]:
  return foldl(lambda sorted, x: insert(lt, x, sorted), [], lst)

def findIndex[A](pred: Callable[[A], bool], ys: list[A]) -> int:
  def go(i: int) -> int:
    if i == len(ys):
      return -1
    if pred(ys[i]):
      return i + 1
    return go(i + 1)
  return go(0)

def findWhere[A](pred: Callable[[A], bool], table: list[A]) -> A:
  return [r for r in table if pred(r)][0]

def model(m: str, t: list[Model]) -> Model:
  return findWhere(lambda r: r.model == m, t)

def maximumBy[A](f: Callable[[A], float], xs: list[A]) -> A:
  return foldl(lambda current, y: y if f(y) > f(current) else current, xs[0], tail(xs))
