from typing import Callable
from dataclasses import dataclass
from util import findWhere

@dataclass
class Ordinal:
  lastDigit: int
  suffix: str

ordinalMap: list[Ordinal] = [Ordinal(1, "st"), Ordinal(2, "nd"), Ordinal(3, "rd")]

def ordinal(n: int) -> str:
  assert n > 0, "n <= 0 not supported"
  if n < 4:
    return num_to_str(n) + findWhere(lambda o: o.lastDigit == n, ordinalMap).suffix
  if n >= 4 and n <= 20:
    return num_to_str(n) + "th"
  assert False, "n > 20 not supported"

def rankLabel(word: str, n: int) -> str:
  prefix: str = "" if n == 1 else ordinal(n) + "-"
  return prefix + word

def trendWord(n1: float, n2: float, compareWord: Callable[[Ordering], str]) -> str:
  return compareWord(compare(n1, n2))

def growShrink(EQ(): Ordering) -> str:
  return "unchanging"
def growShrink(LT(): Ordering) -> str:
  return "shrinking"
def growShrink(GT(): Ordering) -> str:
  return "growing"

def smallerHigher(EQ(): Ordering) -> str:
  return "equal"
def smallerHigher(LT(): Ordering) -> str:
  return "smaller"
def smallerHigher(GT(): Ordering) -> str:
  return "larger"

def improve(EQ(): Ordering) -> str:
  return "does not further improve"
def improve(LT(): Ordering) -> str:
  return "does not further improve"
def improve(GT(): Ordering) -> str:
  return "further improves"

def improvements(EQ(): Ordering) -> str:
  return "no further improvements"
def improvements(LT(): Ordering) -> str:
  return "no further improvements"
def improvements(GT(): Ordering) -> str:
