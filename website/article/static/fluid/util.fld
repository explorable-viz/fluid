def insert(lt, x, []):
  return [x]
def insert(lt, x, y :| ys):
  if x |lt| y:
    return x :| y :| ys
  else:
    return y :| insert(lt, x, ys)

def insertionSort(lt, lst):
  def helper([], sorted):
    return sorted
  def helper(x :| xs, sorted):
    return helper(xs, insert(lt, x, sorted))

  return helper(lst, [])

def findIndex(fName, x, []):
  return -1
def findIndex(fName, x, y :| ys):
  if y[fName] == x:
    return 1
  else:
    return findIndex(fName, x, ys) + 1

def find_with_key_(fName, x, table):
  return from_some(find_with_key(fName, x, table))

def findWhere(pred, table):
  return from_some(find(pred, table))

def model(m, t):
  return find_with_key_("model", m, t)

def maximumBy(f, []):
  return error("Empty list!")
def maximumBy(f, x :| xs):
  def helper([], current):
    return current
  def helper(y :| ys, current):
    if f(y) > f(current):
      return helper(ys, y)
    else:
      return helper(ys, current)

  return helper(xs, x)
