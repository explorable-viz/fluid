import lib.stats
import table1_data

def newDataTable(offset):
  map(lambda s: {
    scenario: s.scenario,
    beNear: s.bestEstNear + offset,
    nearRange: (s.lowNear, s.highNear),
    beMid: s.bestEstMid,
    midRange: (s.lowMid, s.highMid),
    beLong: s.bestEstLate,
    longRange: (s.lowLate, s.highLate)
  }, tableData)

def getByScenario(data, scenario):
  fromSome(findWithKey("scenario", scenario, data))

def probAsText: likelihoodMap(likelihoods)

def mean(xs): sum(xs) / length(xs)

def calcLikelihood((min, max), target):
  if max < target: 0.05
  else:
    if target <= min: 0.95
    else: (target - min) / (max - min)

def getByScenario_: getByScenario(newDataTable(0))
def ssp119: getByScenario_("SSP1-1.9")
def ssp245: getByScenario_("SSP2-4.5")

MultiView([
  f"""Under the low GHG emissions scenario (SSP1-1.9), global warming of 2°C would
      {probAsText(calcLikelihood(ssp119.longRange, 2.0))}
      be exceeded at the end of the 21st century.""",
  f"""Under the intermediate GHG emissions scenario (SSP2-4.5), global warming of 2°C would
      {probAsText(calcLikelihood(ssp245.longRange, 2.0))} be exceeded by the end of the 21st century.
      In the mid-term period (2041-2060), crossing the 2°C mark is
      {probAsText(calcLikelihood(ssp245.midRange, 2.0))} to occur."""
])
