from dataclasses import dataclass

@dataclass
class Emission:
  type: str
  emissions: float

@dataclass
class Prediction:
  model: str
  period: str
  world: float
  world_historical: float
  changed: float

ssp126Source: list[Emission] = load_json(list[Emission], "../../dataset/SPM/ssp126.json")
ssp126preds: list[Prediction] = load_json(list[Prediction], "../../dataset/SPM/ssp126preds.json")
ssp245Source: list[Emission] = load_json(list[Emission], "../../dataset/SPM/ssp245.json")
ssp245preds: list[Prediction] = load_json(list[Prediction], "../../dataset/SPM/ssp245preds.json")
