from dataclasses import dataclass

@dataclass
class Projection:
  scenario: str
  bestEstNear: float
  lowNear: float
  highNear: float
  bestEstMid: float
  lowMid: float
  highMid: float
  bestEstLate: float
  lowLate: float
  highLate: float

@dataclass
class Likelihood:
  prob: float
  msg: str

tableData: list[Projection] = load_json(list[Projection], "../../dataset/SPM/explainable-table.json")
likelihoods: list[Likelihood] = load_json(list[Likelihood], "../../dataset/SPM/likelihoods.json")
