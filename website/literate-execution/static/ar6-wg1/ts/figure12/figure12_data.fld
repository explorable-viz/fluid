from dataclasses import dataclass

@dataclass
class Ensemble:
  ens: dict[str, dict[str, float]]

# Variable, then statistic, then region.
@dataclass
class Hydro:
  pr: dict[str, dict[str, Ensemble]]
  tas: dict[str, dict[str, Ensemble]]
  mrro: dict[str, dict[str, Ensemble]]
  prw: dict[str, dict[str, Ensemble]]

path: str = "../../dataset/TS/inputdata_TS_12/v20230301/WaterCyclePanels/"
hydroData: Hydro = load_json(Hydro, path + "Hydro_vars_change_20210201_derived_extra_raw.json")

# extract from data set instead?
models: list[str] = [
    "HadGEM3-GC31-MM_ssp585",
    "EC-Earth3-Veg_ssp585",
    "ACCESS-CM2_ssp585",
    "HadGEM3-GC31-LL_ssp585",
    "CNRM-CM6-1-HR_ssp585",
    "CESM2-WACCM_ssp585",
    "IPSL-CM6A-LR_ssp585",
    "CIESM_ssp585",
    "CanESM5_ssp585",
    "CanESM5-CanOE_ssp585",
    "EC-Earth3_ssp585",
    "UKESM1-0-LL_ssp585",
    "KACE-1-0-G_ssp585",
    "CNRM-CM6-1_ssp585",
    "CESM2_ssp585"
  ]

def precip(ensemble_data: dict[str, float]) -> float:
  return mean([ ensemble_data[ model ] for model in models ])

precip_std_extra_annual: dict[str, float] = dict_map(precip, hydroData.pr["std"]["extra_annual"].ens)
