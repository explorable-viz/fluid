from dataclasses import dataclass

@dataclass
class Action:
  risk_id: str
  action_id: str
  actions: str
  action_aimed_at: str
  country_of_reference: str
  typology: str
  typology_confidence: str
  extent_addressed: str
  non_nap3_policies: str
  evaluation_score: str
  adas_rationale: str
  risk_owner: str
  action_owner: str

@dataclass
class Risk:
  id: str
  descriptor: str
  ccc_priority: str
  chapter: str
  nation: str
  england_magnitude_present: str
  england_magnitude_2050_2c: str
  england_magnitude_2050_4c: str
  england_magnitude_2080_2c: str
  england_magnitude_2080_4c: str
  england_adaptation_score: str
  england_urgency_score: str
  uk_urgency_score: str
  ccc_progress_england_2019: str
  ccc_progress_scotland_2019: str
  key_policy_opportunities: str
  nature: str
  working_land_and_seas: str
  food_security: str
  water_supply: str
  energy: str
  telecommunications_and_ict: str
  transport: str
  towns_and_cities: str
  buildings: str
  health: str
  community_preparedness_and_response: str
  business: str
  finance: str
  interdependencies: str
  not_captured: str

nap3_actions: list[Action] = load_json(list[Action], "../dataset/ccra3-actions-for-nap3.json")
ccra3_risks: list[Risk] = load_json(list[Risk], "../dataset/ccra3-risks.json")
