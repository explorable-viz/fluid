import figure1_data

def chapter_for_risk:
  dict([ (risk[ "ID#" ], risk[ "Chapter" ]) for risk in risks ])

def chapters:
  groupBy(on((==), lambda r: chapter_for_risk[ r [ "Risk ID#" ] ]), eval_data)

def by_eval_score:
  [ groupBy(on((==), lambda r: r [ "Evaluation score" ]), chapter) for chapter in chapters ]

"""Grouped by ${length(chapters)} chapters."""
