import figure1_data

def eval_scores:
  [ "Significantly addressed", "Recognised but not addressed", "Not addressed", "Minimally addressed", "Fully addressed" ]

def actions_by(key, keys):
  [ { x: key_,
      segments: [
        { y: eval_score,
          z: count_if(
            lambda action: action[ key ] == key_ |and| action[ "Evaluation score" ] == eval_score,
            eval_data
          )
        }
        for eval_score in eval_scores
      ]
    }
    for key_ in keys
  ]

def by_chapter:
  actions_by(
    "Chapter",
    [ "6", "5", "4", "7", "3" ]
  )

def by_owner:
  actions_by(
    "Action Owner",
    [ "Cross-government", "DBT", "DCMS", "Defra", "DESNZ", "DfT", "DHSC", "DLUHC", "DSIT", "FCDO", "HMT", "MoJ" ]
  )

MultiView({
  by_chapter:
    BarChart({
      caption: "Evaluation of NAP3 against actions from CCRA3",
      size: { width: 275, height: 185 },
      stackedBars: by_chapter
    }),
  by_owner:
    BarChart({
      caption: "Actions by government department",
      size: { width: 375, height: 185 },
      stackedBars: by_owner
    })
})
