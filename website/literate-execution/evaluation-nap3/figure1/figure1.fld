import figure1_data

def risk_chapter:
  dict([ (risk[ "ID#" ], risk[ "Chapter" ]) for risk in risks ])

def chapter_for_risk(r):
  risk_chapter[ r [ "Risk ID#" ] ]

def chapters:
  groupBy(on((==), chapter_for_risk), eval_data)

def eval_scores:
  [ groupBy(on((==), lambda r: r [ "Evaluation score" ]), chapter) for chapter in chapters ]

def bars:
  [ { x: "(chapter name)", segments: { y: "(eval score)", z: length(eval_score) } }
    for chapter in eval_scores for eval_score in chapter ]

# now make a 100% stacked bar chart
MultiView(dict([ (bar.x, bar.segments) for bar in bars ]))
