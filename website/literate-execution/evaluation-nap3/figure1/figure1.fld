import figure1_data

def bars:
  [ { x: chapter,
      segments: [
        { y: eval_score,
          z: length(nub([
            action[ "Action ID#" ] for action in eval_data
            if action[ "Chapter" ] == chapter |and| action[ "Evaluation score" ] == eval_score
          ]))
        }
        for eval_score in
          [ "Significantly addressed", "Recognised but not addressed", "Not addressed", "Minimally addressed", "Fully addressed" ]
      ]
    }
    for chapter in [ "6", "5", "4", "7", "3" ]
  ]

BarChart({
  caption: "Evaluation of NAP3 against actions from CCRA3",
  size: { width: 275, height: 185 },
  stackedBars: bars
})
