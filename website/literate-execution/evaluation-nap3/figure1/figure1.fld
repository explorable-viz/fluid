import figure1_data

def risk_chapter:
  dict([ (risk[ "ID#" ], risk[ "Chapter" ]) for risk in risks ])

def chapter_for_risk(r):
  risk_chapter[ r [ "Risk ID#" ] ]

# delete me
def chapters:
  groupBy(on((==), chapter_for_risk), eval_data)

def chapters_:
  [ (chapter_for_risk(head(chapter)), chapter) for chapter in chapters ]

def eval_scores:
  [ groupBy(on((==), lambda r: r [ "Evaluation score" ]), chapter)
    for chapter in chapters ]

def eval_scores_:
  [ (chapter, groupBy(on((==), lambda r: r [ "Evaluation score" ]), risks))
    for (chapter, risks) in chapters_ ]

def bars:
  [ { x: "(chapter name)", segments: { y: "(eval score)", z: length(eval_score) } }
    for chapter in eval_scores for eval_score in chapter ]

def bars_:
  [ (chapter, [ (head(score)[ "Evaluation score" ], length(score)) for score in scores ])
    for (chapter, scores) in eval_scores_ ]

