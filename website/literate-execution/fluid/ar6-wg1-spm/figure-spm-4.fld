let stackedBarHeight stackedBar = sum [ bar.z | bar <- stackedBar.bars ];

let get x (BarChart record) = fromSome (findWithKey "x" x record.stackedBars);

let mkBarChart scenName table = 
    BarChart {
        caption: "Example bar chart for scenario " ++ scenName,
        size: { width: 275, height: 185 },
        stackedBars: map (fun record -> { x: record.type, bars: [ { y: "emissions", z: record.emissions } ]}) table
    };

let getHeight offset bar = (head bar.bars).z + offset;

let changed126 = map (fun r -> r.changed) ssp126preds;
    changed245 = map (fun r -> r.changed) ssp245preds;
    ssp126table = 
        """ 
        We compute the ${this.type} emissions by taking the median of predicted values,
        which are distributed according to ${mkHistogram changed126 this.type 10} 
        """ 
        { type: "Total", emissions: findPercentile 50 changed126 } : ssp126Source;
    ssp245table =
        """
        We build this table analagously to the ssp126
        """
        { type: "Total", emissions: findPercentile 50 changed245 } : ssp245Source;
    ssp126 = mkBarChart "SSP1-2.6" ssp126table;
    ssp245 = mkBarChart "SSP2-4.5" ssp245table;
    totals = map stackedBarHeight (map (get "Total") [ssp126, ssp245]);
    co2s = map stackedBarHeight (map (get "CO2") [ssp126, ssp245]);
    nonco2 = map (get "Non-CO2") [ssp126, ssp245]
in """Within each scenario bar plot, the bars represent total warming (°C), warming from CO2 (°C) and from Non-CO2 GHG's (°C).""" MultiView {
    leftBarChart: ssp126,
    rightBarChart: ssp245,
    explanation:    
        Paragraph [ Text "Within each scenario bar plot, the bars represent:", Link totals " total warming (°C),",
                    Link co2s " warming from CO2 (°C) ", Text " and from ", Link (map stackedBarHeight nonco2) " Non-CO2 GHG's (°C)."
                  ]
}
