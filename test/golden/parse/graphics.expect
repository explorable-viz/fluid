let coords Group gs = Point 0 0;
    coords (Rect x y _ _ _) = Point x y;
    coords (String x y _ _ _) = Point x y;
    coords (Viewport x y _ _ _ _ _ _ _) = Point x y in
let get_x g = let (Point x _) = coords g in
              x in
let get_y g = let (Point _ y) = coords g in
              x in
let set_x x Group gs = error "Group has immutable coordinates";
    set_x x (Rect _ y w h fill) = Rect x y w h fill;
    set_x x (String _ y str anchor baseline) = String x y str anchor baseline;
    set_x x (Viewport _ y w h fill margin scale translate g) = Viewport x y w h fill margin scale translate g in
let dimensions2 ((Point x1 y1), (Point x2 y2)) = Point (max x1 x2) (max y1 y2) in
let dimensions Group gs = foldl (curry dimensions2) (Point 0 0) (map coords_op gs);
    dimensions (Polyline ps _ _) = foldl (curry dimensions2) (Point 0 0) ps;
    dimensions (Rect _ _ w h _) = Point w h;
    dimensions (String _ _ _ _ _) = Point 0 0;
    dimensions (Viewport _ _ w h _ _ _ _ _) = Point w h;
    coords_op g = let ((Point x y), (Point w h)) = prod coords dimensions g in
                  Point (x + w) (y + h) in
let width g = let (Point w _) = dimensions g in
              w in
let height g = let (Point _ h) = dimensions g in
               h in
let spaceRight z sep gs = zipWith set_x (iterate (length gs) ((+) sep) z) gs in
let colours1 = ["#66c2a5", "#a6d854", "#ffd92f", "#e5c494", "#fc8d62", "#b3b3b3", "#8da0cb", "#e78ac3"] in
let colours2 = ["#e41a1c", "#377eb8", "#4daf4a", "#984ea3", "#ff7f00", "#ffff33", "#a65628", "#f781bf"] in
let scaleToWidth w (Rect x y _ h fill) = Rect x y w h fill;
    scaleToWidth w (Viewport x y w0 h fill margin (Scale x_scale y_scale) translate g) = let scale = Scale ((x_scale * w) / w0) y_scale in
                                                                                             Viewport x y w h fill margin scale translate g in
let stackRight sep gs = map (scaleToWidth (1 - sep)) (spaceRight (sep / 2) 1 gs) in
let groupRight sep gs = Viewport 0 0 (length gs) (maximum (map height gs)) "none" 0 (Scale 1 1) (Translate 0 0) (Group (stackRight sep gs)) in
let tickEvery n = let m = floor (logBase 10 n) in
                  if n <= 2 * 10 ** m then 2 * 10 ** (m - 1) else 10 ** m in
let axisStrokeWidth = 0.5;
    axisColour = "black";
    backgroundColour = "white";
    defaultMargin = 24;
    markerRadius = 3.5;
    tickLength = 4 in
let tick (Horiz) colour len = Line (Point 0 0) (Point 0 (0 - len)) colour axisStrokeWidth;
    tick (Vert) colour len = Line (Point 0 0) (Point (0 - len) 0) colour axisStrokeWidth in
let label (Horiz) x distance str = String x ((0 - distance) - 4) str "middle" "hanging";
    label (Vert) x distance str = String (0 - distance) x str "end" "central" in
let labelledTick orient colour len str = Group [tick orient colour len, label orient 0 len str] in
let mkPoint (Horiz) x y = Point y x;
    mkPoint (Vert) x y = Point x y in
let axis orient x start end = let tickSp = tickEvery (end - start);
                                  firstTick = ceilingToNearest start tickSp;
                                  lastTick = ceilingToNearest end tickSp;
                                  n = floor ((end - firstTick) / tickSp) + 1;
                                  ys = iterate n ((+) tickSp) firstTick;
                                  ys = match firstTick > start as
                                       {(True) -> start : ys;
                                         (False) -> ys};
                                  ys = match lastTick > end as
                                       {(True) -> concat2 ys [lastTick];
                                         (False) -> ys};
                                  ps = map (mkPoint orient x) ys;
                                  ax = Group [Line (head ps) (last ps) axisColour axisStrokeWidth, Polymarkers ps (flip map ys (compose (labelledTick orient axisColour tickLength) numToStr))] in
                              (ax, lastTick) in
let catAxis orient x catValues = let ys = iterate (length catValues + 1) ((+) 1) 0;
                                     ps = map (mkPoint orient x) ys in
                                 Group [Line (head ps) (last ps) axisColour axisStrokeWidth, Polymarkers (tail ps) (map (const (tick orient axisColour tickLength)) catValues), Polymarkers (flip map (tail ps) (fun (Point x y) = Point (x - 0.5) y)) (map (label orient -0.5 0) catValues)] in
let viewport x_start x_finish y_finish margin gs = Viewport 0 0 (x_finish - x_start) y_finish backgroundColour margin (Scale 1 1) (Translate (0 - x_start) 0) (Group gs) in
let lineChart withAxes colours x_start data = let xs = map fst data;
                                                  nCat = length (snd (head data)) in
                                              let plot (n, colour) = let ps = map (fun (x, kvs) = Point x (snd (nth n kvs))) data in
                                                                        Group [Polyline ps colour 1, Polymarkers ps (repeat (length ps) (Circle 0 0 markerRadius colour))] in
                                              let lines = zipWith (curry plot) (iterate nCat ((+) 1) 0) colours;
                                                  x_finish = last xs;
                                                  y_finish = maximum (flip map data (fun (_, kvs) = maximum (map snd kvs))) in
                                              match withAxes as
                                              {(True) -> let (x_axis, x_finish) = axis Horiz 0 x_start x_finish;
                                                                (y_axis, y_finish') = axis Vert x_start 0 y_finish in
                                                            viewport x_start x_finish y_finish' defaultMargin (x_axis : (y_axis : lines));
                                                (False) -> viewport x_start x_finish y_finish 0 lines} in
let categoricalChart plotValue withAxes colours sep data = let gs = stackRight sep (plotValue colours (map snd data));
                                                               w = length gs;
                                                               h = maximum (map height gs) in
                                                           match withAxes as
                                                           {(True) -> let x_axis = catAxis Horiz 0 (map fst data);
                                                                             (y_axis, h') = axis Vert 0 0 h in
                                                                         viewport 0 w h' defaultMargin (concat2 gs [x_axis, y_axis]);
                                                             (False) -> viewport 0 w h 0 gs} in
let rects colours ns = zipWith (fun colour n = Rect 0 0 1 n colour) colours ns in
let stackedBar colours ns = let heights = map snd ns;
                                subtotals = scanl1 (+) 0 heights;
                                dims = zip (0 : subtotals) heights;
                                rects = map (fun ((y, height), colour) = Rect 0 y 1 height colour) (zip dims colours) in
                            Viewport 0 0 1 (last subtotals) "none" 0 (Scale 1 1) (Translate 0 0) (Group rects) in
let barChart = categoricalChart rects in
let groupedBarChart = categoricalChart (compose map (flip (barChart False) 0)) in
let stackedBarChart = categoricalChart (compose map stackedBar) in
let caption str (Viewport x y w h fill margin scale translate g) = let g' = Group [String (x + w / 2) -2 str "middle" "hanging", Viewport 0 0 w h fill margin scale translate g] in
                                                                     Viewport x y w h backgroundColour (defaultMargin / 2 + 4) (Scale 1 1) (Translate 0 0) g' in
0
