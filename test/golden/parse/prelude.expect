let and (False) y = False in
let and (True) y = y in
let or (True) y = True in
let or (False) y = y in
let not (True) = False in
let not (False) = True in
let compare x y = if x > y then GT else if x < y then LT else EQ in
let negate = (-) 0 in
let logBase x y = log y / log x in
let ceilingToNearest n m = ceiling (n / m) * m in
let compose f g x = f (g x) in
let curry f x y = f ((x, y)) in
let uncurry f (x, y) = f x y in
let const x _ = x in
let first f (a, c) = (f a, c) in
let snd (_, y) = y in
let second f (c, a) = (c, f a) in
let flip f x y = f y x in
let fst (x, _) = x in
let id x = x in
let prod f g x = (f x, g x) in
let swap (a, b) = (b, a) in
let head [] = error "Can't take head of empty list" in
let head (x : _) = x in
let tail [] = error "Can't take tail of empty list" in
let tail (_ : xs) = xs in
let elem x [] = False in
let elem x (x' : xs) = x == x' `or` elem x xs in
let find p [] = error "not found" in
let find p (x : xs) = if p x then Some x else find p xs in
let findWithKey fname fval table = find (fun y = y.[fname] == fval) table in
let fromSome option = match option as
                      {(None) -> error "Expected Some!";
                        Some x -> x} in
let filter p [] = [] in
let filter p (x : xs) = let ys = filter p xs in
                          if p x then x : ys else ys in
let filterMap p [] = [] in
let filterMap p (x : xs) = match p x as
                             {(None) -> filterMap f xs;
                               Some y -> y : filterMap f xs} in
let foldl op z [] = z in
let foldl op z (x : xs) = foldl op (op z x) xs in
let foldl1 op (x : xs) = foldl op x xs in
let foldr op z [] = z in
let foldr op z (x : xs) = op x (foldr op z xs) in
let foldr1 op [x] = x in
let foldr1 op (x : (y : xs)) = op x (foldr1 op (y : xs)) in
let scanl1 op z xs = let go x continue acc = let next = op acc x in
                                             next : continue next in
                     foldr go (const []) xs z in
let scanl op z xs = z : scanl1 op z xs in
let map f [] = [] in
let map f (x : xs) = f x : map f xs in
let append ([], ys) = ys in
let append ((x : xs), ys) = x : append ((xs, ys)) in
let concat2 [] ys = ys in
let concat2 (x : xs) ys = x : concat2 xs ys in
let concat = foldl concat2 [] in
let concatMap f xs = concat (map f xs) in
let intersperse [] _ = [] in
let intersperse [x] _ = [x] in
let intersperse (x : (y : ys)) sep = x : (sep : intersperse (y : ys) sep) in
let iterate n f z = if n == 0 then [] else z : map f (iterate (n - 1) f z) in
let sum = foldr (+) 0 in
let last [x] = x in
let last (x : (y : ys)) = last (y : ys) in
let length [] = 0 in
let length (_ : xs) = 1 + length xs in
let reverse [] = [] in
let reverse (x : xs) = append ((reverse xs, [x])) in
let repeat = flip iterate id in
let take n xs = if n <= 0 then [] else match xs as
                                        {[] -> [];
                                          (x : xs) -> x : take (n - 1) xs} in
let drop n xs = if n <= 0 then xs else match xs as
                                       {[] -> [];
                                         (_ : xs) -> drop (n - 1) xs} in
let lastN n xs = foldl (compose const (drop 1)) xs (drop n xs) in
let nth n (x : xs) = if n == 0 then x else nth (n - 1) xs in
let nth2 i j xss = nth (j - 1) (nth (i - 1) xss) in
let lookup k [] = error "Key not found in map" in
let lookup k ((k', v) : kvs) = if k == k' then v else lookup k kvs in
let max n m = if n > m then n else m in
let min n m = if n < m then n else m in
let maximum = foldr1 max in
let minimum = foldr1 min in
let unzip [] = ([], []) in
let unzip ((x, y) : zs) = let (xs, ys) = unzip zs in
                               (x : xs, y : ys) in
let zipWith op [] ys = [] in
let zipWith op (x : xs) [] = [] in
let zipWith op (x : xs) (y : ys) = op x y : zipWith op xs ys in
let zip = zipWith (curry id) in
let enumFromTo n m = if n <= m then n : [n + 1..m] else [] in
let range (m1, n1) (m2, n2) = [(i1, i2)|i1 <- [m1..m2], i2 <- [n1..n2]] in
let abs x y = if x - y < 0 then negate (x - y) else x - y in
let nub xs = let nub' [] _ = [] in
             let nub' (x : xs) ys = if x `elem` ys then nub' xs ys else x : nub' xs (x : ys) in
             nub' xs [] in
let slice begin end xs = take (end - begin) (drop begin xs) in
let splitOn p data = let go fls trs [] = (reverse fls, reverse trs) in
                     let go fls trs (x : xs) = if p x then go fls (x : trs) xs else go (x : fls) trs xs in
                     go [] [] data in
0
