def comp(Infty, Infty): EQ
def comp(Infty, FNum(y)): GT
def comp(FNum(x), Infty): LT
def comp(FNum(x), FNum(y)): compare(x, y);

def fmin(x, y):
  match comp(x, y):
    case LT: x
    case EQ: x
    case GT: y;

def minimal: foldl1(fmin);

def add(Infty, _): Infty
def add(FNum(x), Infty): Infty
def add(FNum(x), FNum(y)): FNum(x + y);

def eq(Infty, Infty): True
def eq(Infty, FNum(x)): False
def eq(FNum(x), Infty): False
def eq(FNum(x), FNum(y)): x == y;
