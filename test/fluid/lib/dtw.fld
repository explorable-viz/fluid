import lib.fnum

def nextIndices(n, m, window):
  [(i, j) for i in [1 .. n] for j in [max(1, i - window) .. min(m, i + window)]]

def costMatrixInit(rows, cols, window):
  def initV(n, m):
    if (n == 1 |and| m == 1) |or| (abs(n, m) <= window |and| not(n == 1 |or| m == 1)): FNum(0)
    else: Infty
  [| initV(n, m) for (n, m) in (rows, cols) |]

def minAndPrev((i, j), im1, jm1, ijm1):
  def minim:
    minimal([im1, jm1, ijm1])

  if minim |eq| im1: ((i, j + 1), minim)
  else:
    if minim |eq| jm1: ((i + 1, j), minim)
    else: ((i, j), minim)

def extractPath(indmatrix, (n, m), accum):
  if n == 1 |and| m == 1: accum
  else:
    extractPath(indmatrix, indmatrix ! (n, m), (n - 1, m - 1) :| accum)

def localMinUpdate(seq1, seq2, cost, (costmatrix, indmatrix), (i, j)):
  def iEntr: nth(i - 1, seq1)
  def jEntr: nth(j - 1, seq2)
  def dist: cost(iEntr, jEntr)
  def ip: i + 1
  def jp: j + 1
  def im1:
    costmatrix ! (i, jp)
  def jm1:
    costmatrix ! (ip, j)
  def im1jm1: costmatrix ! (i, j)
  def (prev, FNum(minim)):
    minAndPrev((i, j), im1, jm1, im1jm1)
  def newVal: FNum(dist + minim)

  (matrixUpdate(costmatrix, (ip, jp), newVal), matrixUpdate(indmatrix, (ip, jp), prev))

def computeDTW(seq1, seq2, cost, window):
  def n: length(seq1)
  def m: length(seq2)
  def initD:
    costMatrixInit(n + 1, m + 1, window)
  def initI:
    [| 0 for (i, j) in (n + 1, m + 1) |]
  def indexing:
    nextIndices(n, m, window)
  def (finished, indices):
    foldl(localMinUpdate(seq1, seq2, cost), (initD, initI), indexing)

  (finished, extractPath(indices, (n + 1, m + 1), Nil))
