def d(x, y): (x - y) * (x - y);

def avg(x, y): (x + y) / ⸨2⸩;

def avgSeq(seq1, seq2, f):
  map(lambda (i, j): f(nth(i - 1, seq1), nth(j - 1, seq2)));

def seq1: [3, ⸨1⸩, 2, 2, 1]
def seq2: [2, 0, ⸨0⸩, 3, 3, 1, 0]
def window: 2
def (costs, matched): computeDTW(seq1, seq2, d, window);

avgSeq(seq1, seq2, avg, matched)
