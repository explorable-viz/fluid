def map(f, []): []
def map(f, x :| xs): ⸨f(x) :| map(f, xs)⸩

def data:
  [
    { energyType: "Bio", output: 6.2 },
    { energyType: "Hydro", output: 260 },
    { energyType: "Solar", output: 19.9 },
    { energyType: "Wind", output: 91 },
    { energyType: ⸨"Geo"⸩, output: 14.4 }
  ]
def output:
  ⸨[row.output for type in ["Hydro", "Solar", ⸨"Geo"⸩] for row in data if row.energyType == type]⸩

map(lambda x: floor((x / sum(output)) * 100), output)
