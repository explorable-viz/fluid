import dataset.renewables

MultiView({
  barChart:
    def totalFor(c, rows):
      sum([row.output for row in rows if row.country == c])

    def data2015: [row for row in renewables if row.year == 2015]
    def countryData:
      [{ x: c, segments: [{ y: "output", z: totalFor(c, data2015) }] } for c in [
        "China",
        "USA",
        "Germany"
      ]]

    BarChart({
      caption: "Total output by country",
      size: { width: 275, height: 185 },
      stackedBars: countryData
    }),
  lineChart:
    def series(type, country):
      [{ x: row.year, y: row.output } for year in [2013 .. 2018] for row in renewables if row.year == year if row.energyType == type if row.country == country]

    LineChart({
      tickLabels: { x: Default, y: Default },
      size: { width: 330, height: 285 },
      caption: "Output of USA relative to China",
      plots:
        [LinePlot({ name: type, points: plot }) for type in [
          "Bio",
          "Hydro",
          "Solar",
          "Wind"
        ] for plot in [zipWith((lambda p1, p2: { x: p1.x, y: p1.y / p2.y }), series(type, "USA"), series(type, "China"))]]
    })
})
