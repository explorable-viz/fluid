import lib.graphics
import dataset.renewablesRestricted

def year: 2015

def exclude(countries, yearData):
  flip(map, yearData, second(filter(lambda (country, countryData): not(elem(country, countries)))))

caption("Renewables (GW) by country and energy type, " ++ numToStr(year), groupedBarChart(True, colours1, 0.2, exclude([], lookup(year, data))))
