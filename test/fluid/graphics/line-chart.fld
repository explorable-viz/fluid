import lib.graphics
import dataset.renewablesRestricted

def year1: head(data)

def addTotal(kvs):
  ("Total", sum(map(snd, kvs))) :| kvs

def countryData(country):
  map(second(compose(addTotal, lookup(country))), data)

(lambda country: caption(country, lineChart(True, "black" :| colours1, fst(year1), countryData(country))))("China")
