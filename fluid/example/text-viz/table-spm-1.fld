let newDataTable offset = map (fun s -> { scenario: s.scenario, beNear: s.bestEstNear + offset, lowNear: s.lowNear, highNear: s.highNear, beMid: s.bestEstMid, lowMid: s.lowMid, highMid: s.highMid, beLate: s.bestEstLate, lowLate: s.lowLate, highLate: s.highLate}) tableData;
let newModel offset = map (fun s -> { model: s.model, probability: s.probability + offset}) modelProbs;

let getByScenario data scenario = fromSome (getByField "scenario" scenario data);

let probAsText = likelihoodMap likelihoods;

let realTable = newDataTable 0;
    getByScenario' = getByScenario realTable;
    ssp119 = getByScenario' "SSP1-1.9";
    ssp245 = getByScenario' "SSP2-4.5"
in MultiView {
    explanation119:
        LinkedText [ "Under the low GHG emissions scenario (SSP1-1.9), global warming of 2°C would ",
                     @ probAsText (computeProb (ssp119.lowLate, ssp119.highLate) 2.0) @, 
                     " be exceeded by the end of the 21st century."  ],
    explanation245:
        LinkedText [ "Under the intermediate GHG emissions scenario (SSP2-4.5), global warming of 2°C would ",
                     probAsText (computeProb (ssp245.lowLate, ssp245.highLate) 2.0),
                     " be exceeded by the end of the 21st century." ]
    }
