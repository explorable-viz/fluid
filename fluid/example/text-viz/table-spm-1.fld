let newDataTable offset = map (fun s -> { scenario: s.scenario, bENear: s.bestEstNear + offset, lowNear: s.lowNear, highNear: s.highNear, bEMid: s.bestEstMid, lowMid: s.lowMid, highMid: s.highMid, bELate: s.bestEstLate, lowLate: s.lowLate, highLate: s.highLate}) tableData;
let newModel offset = map (fun s -> { model: s.model, probability: s.probability + offset}) modelProbs;

let getByScenario data scenario = match (getByField "scenario" scenario data) as {
        None -> error "absurd";
        Some x -> x
    };

let probAsText = likelihoodMap likelihoods;

let realTable = newDataTable 0;
    getByScenario' = getByScenario realTable;
    ssp119 = getByScenario' "SSP1-1.9";
    ssp245 = getByScenario' "SSP2-4.5"
in MultiView {
    table: tableData,
    explanation :
        LinkedText [ "The low-emissions scenario - ", ssp119.scenario ," - projects a temperature increase of "
                     , numToStr ssp119.bELate, " by the end of the century."
                     , "Under this model, it is ", probAsText (computeProb (ssp119.lowLate, ssp119.highLate) 1.5)
                     , " that global temperature increase will exceed the target of 2°C by the end of the century."
                     , " On the other hand, in a higher emissions scenario, like the intermediate scenario SSP2-4.5, it is "
                     , probAsText (computeProb (ssp245.lowLate, ssp245.highLate) 3.0)
                     , " that global temperature increase will exceed this target." ]}
