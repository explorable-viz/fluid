let newDataTable offset = map (fun s -> { scenario: s.scenario, bENear: s.bestEstNear + offset, lowNear: s.lowNear, highNear: s.highNear, bEMid: s.bestEstMid, lowMid: s.lowMid, highMid: s.highMid, bELate: s.bestEstLate, lowLate: s.lowLate, highLate: s.highLate}) tableData;
let newModel offset = map (fun s -> { model: s.model, probability: s.probability + offset}) modelProbs;

let getByScenario scenario data = getByField "scenario" scenario data;

-- likelihoodMap (findLikelihood (sspone.lowLate, sspone.highLate) 2.0)
-- likelihoodMap (findLikelihood (ssptwo.lowLate, ssptwo.highLate) 2.0)

let likelihoodMap prob = (find (fun x -> x.prob <= prob) likelihoods).msg;

let findLikelihood (min, max) target =
    if target > max
    then 0.0
    else if target < min
    then 1.0
    else (target - min)/(max - min);

let realTable = newDataTable 0;
    probTable = newModel 0.0;
    sspone = getByScenario "SSP1-1.9" realTable;
    ssptwo = getByScenario "SSP2-4.5" realTable
in MultiView {
    table: tableData,
    explanation :
        LinkedText [ "The low-emissions scenario - ", sspone.scenario ," - projects a temperature increase of "
                     , numToStr sspone.bELate, " by the end of the century."
                     , "Under this model, it is ", "exceptionally unlikely"
                     , " that global temperature increase will exceed the target of 2c by the end of the century."
                     , " On the other hand, in a higher emissions scenario, like the intermediate scenario SSP2-4.5, it is "
                     , "virtually certain"
                     , " that global temperature increase will exceed this target." ]}
