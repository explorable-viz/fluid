@dataclass
class View:
  pass

@dataclass
class BarChart(View):
  config: Any

@dataclass
class LineChart(View):
  config: Any

@dataclass
class MultiView(View):
  views: Any

@dataclass
class Paragraph(View):
  fragments: Any

@dataclass
class ScatterPlot(View):
  config: Any

@dataclass
class LinePlot:
  config: Any

@dataclass
class Orientation:
  pass

@dataclass
class Default(Orientation):
  pass

@dataclass
class Rotated(Orientation):
  pass

@dataclass
class ParaFragment:
  pass

@dataclass
class Text(ParaFragment):
  text: Any

@dataclass
class Link(ParaFragment):
  value: Any
  label: Any
