@dataclass
class View:
  pass

@dataclass
class BarChart(View):
  caption: Any  # Str
  size: Any  # { width: Int, height: Int }
  tickLabels: Any  # { x: Orientation, y: Orientation }
  stackedBars: Any  # List StackedBar
  legend: Any  # Bool

@dataclass
class LineChart(View):
  size: Any  # { width: Int, height: Int }
  tickLabels: Any  # { x: Orientation, y: Orientation }
  caption: Any  # Str
  plots: Any  # List LinePlot

@dataclass
class MultiView(View):
  views: Any  # List View

@dataclass
class Paragraph(View):
  fragments: Any  # List View

@dataclass
class ScatterPlot(View):
  caption: Any  # Str
  points: Any  # List { x: Float, y: Float }
  labels: Any  # { x: Str, y: Str }

@dataclass
class LinePlot:
  name: Any  # Str
  points: Any  # List { x: Float, y: Float }

@dataclass
class Orientation:
  pass

@dataclass
class Default(Orientation):
  pass

@dataclass
class Rotated(Orientation):
  pass

@dataclass
class ParaFragment:
  pass

@dataclass
class Text(ParaFragment):
  text: Any  # Str

@dataclass
class Link(ParaFragment):
  value: Any  # Val
  label: Any  # Str
