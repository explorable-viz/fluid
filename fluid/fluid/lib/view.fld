@dataclass
class View:
  pass

@dataclass
class BarChart(View):
  config: Any  # { caption: Str, size: { width: Int, height: Int },
               #   tickLabels: { x: Orientation, y: Orientation },
               #   stackedBars: List StackedBar, legend: Bool }

@dataclass
class LineChart(View):
  config: Any  # { size: { width: Int, height: Int },
               #   tickLabels: { x: Orientation, y: Orientation },
               #   caption: Str, plots: List LinePlot }

@dataclass
class MultiView(View):
  views: Any  # List View

@dataclass
class Paragraph(View):
  fragments: Any  # List View

@dataclass
class ScatterPlot(View):
  config: Any  # { caption: Str, points: List { x: Float, y: Float },
               #   labels: { x: Str, y: Str } }

@dataclass
class LinePlot:
  config: Any  # { name: Str, points: List { x: Float, y: Float } }

@dataclass
class Orientation:
  pass

@dataclass
class Default(Orientation):
  pass

@dataclass
class Rotated(Orientation):
  pass

@dataclass
class ParaFragment:
  pass

@dataclass
class Text(ParaFragment):
  text: Any  # Str

@dataclass
class Link(ParaFragment):
  value: Any  # Val
  label: Any  # Str
