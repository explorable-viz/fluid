@dataclass
class Bool:
  pass

@dataclass
class True(Bool):
  pass

@dataclass
class False(Bool):
  pass

@dataclass
class NoneType:
  pass

@dataclass
class None(NoneType):
  pass

@dataclass
class List:
  pass

@dataclass
class Nil(List):
  pass

@dataclass
class Cons(List):
  head: Any
  tail: Any

@dataclass
class Maybe:
  pass

@dataclass
class Nothing(Maybe):
  pass

@dataclass
class Just(Maybe):
  value: Any

@dataclass
class Pair:
  fst: Any
  snd: Any

@dataclass
class Tree:
  pass

@dataclass
class Empty(Tree):
  pass

@dataclass
class NonEmpty(Tree):
  left: Any
  value: Any
  right: Any

@dataclass
class Ordering:
  pass

@dataclass
class LT(Ordering):
  pass

@dataclass
class EQ(Ordering):
  pass

@dataclass
class GT(Ordering):
  pass

@dataclass
class InfNum:
  pass

@dataclass
class FNum(InfNum):
  value: Any

@dataclass
class Infty(InfNum):
  pass
