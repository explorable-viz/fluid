def zero(m, n, image):
  def (m_max, n_max): dims(image)
  if m >= 1 and m <= m_max and n >= 1 and n <= n_max: image ! (m, n)
  else: 0

def wrap(m, n, image):
  def (m_max, n_max): dims(image)
  image ! (((m - 1) % m_max) + 1, ((n - 1) % n_max) + 1)

def extend(m, n, image):
  def (m_max, n_max): dims(image)
  def m_:
    min(max(m, 1), m_max)
  def n_:
    min(max(n, 1), n_max)
  image ! (m_, n_)

def matrixSum(matr):
  def (m, n): dims(matr)
  foldl((+), 0, [matr ! (i, j) for (i, j) in range((1, 1), (m, n))])

def convolve(image, kernel, lookup):
  def ((m, n), (i, j)):
    (dims(image), dims(kernel))
  def (half_i, half_j):
    (i |quot| 2, j |quot| 2)
  def area: i * j
  def interMatrix(m_, n_):
    [| lookup(((m_ + i_) - 1) - half_i, ((n_ + j_) - 1) - half_j, image) * kernel ! (i_, j_) for (i_, j_) in (i, j) |]

  [| matrixSum(interMatrix(m_, n_)) |quot| area for (m_, n_) in (m, n) |]

def matMul(a, b):
  def ((m, n), (i, j)): (dims(a), dims(b))

  if not(n == i):
    error("Dimensions don't line up")
  else:
    @doc(f"""Intermediate matrix""")
    [| sum([a!(i_, k) * b!(k, j_) for k in enumFromTo(1, n)]) for (i_, j_) in (m, j) |]
