def lookup[V](k: int, Empty(): Tree[tuple[int, V]]) -> V | None:
  return None
def lookup[V](k: int, NonEmpty(t1, (key, val), t2): Tree[tuple[int, V]]) -> V | None:
  match compare(k, key):
    case LT():
      return lookup(k, t1)
    case EQ():
      return val
    case GT():
      return lookup(k, t2)

lookup(6, NonEmpty(NonEmpty(Empty(), (3, "simon"), Empty()), (4, "john"), NonEmpty(NonEmpty(Empty(), (6, "sarah"), Empty()), (7, "claire"), Empty())))
