def zip3[A, B]([]: list[A], []: list[B]) -> list[tuple[A, B]]:
  return []
def zip3[A, B]([x1]: list[A], [y1]: list[B]) -> list[tuple[A, B]]:
  return [(x1, y1)] + zip3([], [])
def zip3[A, B]([x1, x2]: list[A], [y1, y2]: list[B]) -> list[tuple[A, B]]:
  return [(x1, y1)] + zip3([x2], [y2])
def zip3[A, B]([x1, x2, x3]: list[A], [y1, y2, y3]: list[B]) -> list[tuple[A, B]]:
  return [(x1, y1)] + zip3([x2, x3], [y2, y3])
def zip3[A, B](xs: list[A], ys: list[B]) -> list[tuple[A, B]]:
  return [(xs[i], ys[i]) for i in range(0, len(xs))]

len(zip3([3, 4, 5, 6], [5, 6, 7, 8]))
