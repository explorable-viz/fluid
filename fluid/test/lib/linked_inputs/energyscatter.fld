from dataset.energy_data import renewables, nonRenewables, Renewable, NonRenewable

from fluid.view import AxisLabels, Point, ScatterPlot

def isCountry(name: str, x: Renewable | NonRenewable) -> bool:
  return name == x.country
def isYear(year: int, x: Renewable | NonRenewable) -> bool:
  return year == x.year

def plot(year: int, countries: list[str]) -> list[Point]:
  rens: list[Renewable] = filter(isYear(year), renewables)
  nonRens: list[NonRenewable] = filter(isYear(year), nonRenewables)

  def plotCountry(country: str) -> Point:
    rens_: list[Renewable] = filter(isCountry(country), rens)
    rensOut: float = fsum(map(lambda x: x.output, rens_))
    rensCap: float = fsum(map(lambda x: x.capacity, rens_))
    x: NonRenewable = filter(isCountry(country), nonRens)[0]
    nonRensCap: float = ((x.nuclearCap + x.petrolCap) + x.gasCap) + x.coalCap

    return Point(
      x=rensCap / (rensCap + nonRensCap),
      y=(rensOut + x.nuclearOut) / (rensCap + x.nuclearCap)
    )

  return map(plotCountry, countries)

ScatterPlot(
  caption="Clean energy efficiency vs. proportion of renewable energy capacity",
  points=plot(2018, [ "BRA", "CHN", "DEU", "FRA", "EGY", "IND", "JPN", "MEX", "NGA", "USA" ]),
  labels=AxisLabels(x="Renewables/TotalEnergyCap", y="Clean Capacity Factor")
)
