def flatten[K, V](Empty(): SearchTree[K, V]) -> list[tuple[K, V]]:
  return []
def flatten[K, V](NonEmpty(t1, (key, val), t2): SearchTree[K, V]) -> list[tuple[K, V]]:
  return flatten(t1) + [(key, val)] + flatten(t2)

empty: SearchTree[int, str] = Empty[tuple[int, str]]()
flatten(NonEmpty(NonEmpty(empty, (3, "simon"), empty), (4, "john"), NonEmpty(NonEmpty(empty, (6, "sarah"), empty), (7, "claire"), empty)))
