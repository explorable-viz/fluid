from typing import Callable
from math import floor
from dependence.section_5_example_inputs import data, types
from fluid.prelude import fsum

def map[A, B](f: Callable[[A], B], xs: list[A]) -> list[B]:
  return [f(x) for x in xs]

output: list[float] = [row.output for type in types for row in data if row.energyType == type]
def percent(x: float) -> int:
  return floor((x / fsum(output)) * 100)

map(percent, output)
