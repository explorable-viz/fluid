from typing import Callable
import fnum
from dtw import computeDTW
from dependence.dtw.dtw_inputs import seq1, seq2, window

def d(x: int, y: int) -> int:
  return (x - y) * (x - y)

def avg(x: int, y: int) -> float:
  return (x + y) / 2

def avgSeq(seq1: list[int], seq2: list[int], f: Callable[[int, int], float]) -> Callable[[list[tuple[int, int]]], list[float]]:
  return map(lambda (i, j): f(seq1[i], seq2[j]))

(costs, matched) = computeDTW(seq1, seq2, d, window)
avgSeq(seq1, seq2, avg, matched)
