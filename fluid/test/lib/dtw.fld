from typing import Callable
from fnum import minimal, eq
from fluid.prelude import abs, FNum, foldl, InfNum, Infty, max, min

type Cell = tuple[int, int]
type CostMatrix = Matrix[InfNum]
type PathMatrix = Matrix[Cell]

def nextIndices(n: int, m: int, window: int) -> list[Cell]:
  return [(i, j) for i in range(0, n) for j in range(max(0, i - window), min(m, i + window + 1))]

def costMatrixInit(rows: int, cols: int, window: int) -> CostMatrix:
  def initV(n: int, m: int) -> InfNum:
    if (n == 0 and m == 0) or (abs(n - m) <= window and not(n == 0 or m == 0)):
      return FNum(0)
    else:
      return Infty()
  return [| initV(n, m) for (n, m) in (rows, cols) |]

def minAndPrev((i, j): Cell, im1: InfNum, jm1: InfNum, ijm1: InfNum) -> tuple[int, int, InfNum]:
  minim: InfNum = minimal([im1, jm1, ijm1])
  if minim |eq| im1:
    return i, j + 1, minim
  else:
    if minim |eq| jm1:
      return i + 1, j, minim
    else:
      return i, j, minim

def extractPath(indmatrix: PathMatrix, (n, m): Cell, accum: list[Cell]) -> list[Cell]:
  if n == 0 and m == 0:
    return accum
  else:
    return extractPath(indmatrix, indmatrix[n, m], [(n - 1, m - 1)] + accum)

def localMinUpdate[A](seq1: list[A], seq2: list[A], cost: Callable[[A, A], float], (costmatrix, indmatrix): tuple[CostMatrix, PathMatrix], (i, j): Cell) -> tuple[CostMatrix, PathMatrix]:
  iEntr: A = seq1[i]
  jEntr: A = seq2[j]
  dist: float = cost(iEntr, jEntr)
  ip: int = i + 1
  jp: int = j + 1
  im1: InfNum = costmatrix[i, jp]
  jm1: InfNum = costmatrix[ip, j]
  im1jm1: InfNum = costmatrix[i, j]
  (pi, pj, FNum(minim)) = minAndPrev((i, j), im1, jm1, im1jm1)
  newVal: InfNum = FNum(dist + minim)

  return matrixUpdate(costmatrix, (ip, jp), newVal), matrixUpdate(indmatrix, (ip, jp), (pi, pj))

def computeDTW[A](seq1: list[A], seq2: list[A], cost: Callable[[A, A], float], window: int) -> tuple[CostMatrix, list[Cell]]:
  n: int = len(seq1)
  m: int = len(seq2)
  initD: CostMatrix = costMatrixInit(n + 1, m + 1, window)
  initI: PathMatrix = [| (0, 0) for (i, j) in (n + 1, m + 1) |]
  indexing: list[Cell] = nextIndices(n, m, window)
  finished, indices = foldl(localMinUpdate(seq1, seq2, cost), (initD, initI), indexing)

  return finished, extractPath(indices, (n, m), [])
