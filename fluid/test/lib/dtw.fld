from typing import Callable
from fnum import minimal, eq

def nextIndices(n: int, m: int, window: int) -> list[tuple[int, int]]:
  return [(i, j) for i in range(0, n) for j in range(max(0, i - window), min(m, i + window + 1))]

def costMatrixInit(rows: int, cols: int, window: int) -> Matrix[InfNum]:
  def initV(n: int, m: int) -> InfNum:
    if (n == 0 and m == 0) or (abs(n - m) <= window and not(n == 0 or m == 0)):
      return FNum(0)
    else:
      return Infty()
  return [| initV(n, m) for (n, m) in (rows, cols) |]

def minAndPrev((i, j): tuple[int, int], im1: InfNum, jm1: InfNum, ijm1: InfNum) -> tuple[int, int, InfNum]:
  minim: InfNum = minimal([im1, jm1, ijm1])
  if minim |eq| im1:
    return (i, j + 1, minim)
  else:
    if minim |eq| jm1:
      return (i + 1, j, minim)
    else:
      return (i, j, minim)

def extractPath(indmatrix: Matrix[tuple[int, int]], (n, m): tuple[int, int], accum: list[tuple[int, int]]) -> list[tuple[int, int]]:
  if n == 0 and m == 0:
    return accum
  else:
    return extractPath(indmatrix, indmatrix[n, m], [(n - 1, m - 1)] + accum)

def localMinUpdate[A](seq1: list[A], seq2: list[A], cost: Callable[[A, A], float], (costmatrix, indmatrix): tuple[Matrix[InfNum], Matrix[tuple[int, int]]], (i, j): tuple[int, int]) -> tuple[Matrix[InfNum], Matrix[tuple[int, int]]]:
  iEntr: A = seq1[i]
  jEntr: A = seq2[j]
  dist: float = cost(iEntr, jEntr)
  ip: int = i + 1
  jp: int = j + 1
  im1: InfNum = costmatrix[i, jp]
  jm1: InfNum = costmatrix[ip, j]
  im1jm1: InfNum = costmatrix[i, j]
  (pi, pj, FNum(minim)) = minAndPrev((i, j), im1, jm1, im1jm1)
  newVal: InfNum = FNum(dist + minim)

  return (matrixUpdate(costmatrix, (ip, jp), newVal), matrixUpdate(indmatrix, (ip, jp), (pi, pj)))

def computeDTW[A](seq1: list[A], seq2: list[A], cost: Callable[[A, A], float], window: int) -> tuple[Matrix[InfNum], list[tuple[int, int]]]:
  n: int = len(seq1)
  m: int = len(seq2)
  initD: Matrix[InfNum] = costMatrixInit(n + 1, m + 1, window)
  initI: Matrix[tuple[int, int]] = [| (0, 0) for (i, j) in (n + 1, m + 1) |]
  indexing: list[tuple[int, int]] = nextIndices(n, m, window)
  (finished, indices) = foldl(localMinUpdate(seq1, seq2, cost), (initD, initI), indexing)

  return (finished, extractPath(indices, (n, m), []))
