import lib.graphics
import dataset.renewables_restricted

def rect =
  Rect(0, 0, 1, 3, "red")
def g =
  Group([
    Viewport(0, 0, 1, 3, "white", 0, Scale(1, 1), Translate(0, 0), rect)
  ])
def w = 1.0
def m = 0.25
def x_scale =
  max(w - 2 * m, 0) / w
def translate =
  Translate(m / x_scale, 0)

Viewport(0, 0, w, 3, "gray", 0, Scale(x_scale, 1), translate, g)
