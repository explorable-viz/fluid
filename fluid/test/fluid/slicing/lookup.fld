def lookup(k, Empty): None
def lookup(k, NonEmpty(t1, (key, val), t2)):
  match compare(k, key):
    case LT: lookup(k, t1)
    case EQ: Some(val)
    case GT: lookup(k, t2)

lookup(6, NonEmpty(NonEmpty(Empty, (3, "USA"), Empty), (4, "China"), NonEmpty(NonEmpty(Empty, (6, "Germany"), Empty), (7, "UK"), Empty)))
