import lib.fnum
import lib.dtw
import slicing.dtw.dtw_inputs

def d(x, y):
  return (x - y) * (x - y)

def avg(x, y):
  return (x + y) / 2

def avgSeq(seq1, seq2, f):
  return map(lambda (i, j): f(nth(i, seq1), nth(j, seq2)))

def (costs, matched) =
  computeDTW(seq1, seq2, d, window)

avgSeq(seq1, seq2, avg, matched)
