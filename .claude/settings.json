{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./script/integrity-session-hook.sh",
            "timeout": 60,
            "statusMessage": "Checking project integrity"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "conventions@fluid-org": true
  },
  "extraKnownMarketplaces": {
    "fluid-org": {
      "source": {
        "source": "github",
        "repo": "fluid-org/claude-plugins"
      }
    }
  }
}
